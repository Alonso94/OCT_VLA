# Copy to ignored .env and replace placeholders locally.
# Load explicitly with: octvla doctor --env-file .env
# CLI > process environment > env file > JSON config > derived defaults.
# No shell execution or variable expansion. Quote paths containing spaces.
ROBOTWIN_ROOT=/path/to/existing/RoboTwin
OCTVLA_ROBOTWIN_PYTHON=/path/to/existing/simulator/environment/bin/python
OCTVLA_POLICY_PYTHON=/path/to/existing/policy/environment/bin/python
OCTVLA_DATA_ROOT=/path/to/existing/datasets
OCTVLA_ASSET_ROOT=/path/to/existing/assets
OCTVLA_OUTPUT_ROOT=/path/to/new/experiment/outputs
